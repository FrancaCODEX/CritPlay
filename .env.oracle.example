# Copie para .env.oracle. O arquivo real e seus segredos são ignorados pelo Git.
# Domínio sem https://, porta ou caminho, com DNS apontado para a VM.
CRITPLAY_DOMAIN=critplay.seu-dominio.example
ACME_EMAIL=
# Use valores longos e aleatórios. Não altere DB_PASSWORD após criar o banco
# sem também trocar a senha dentro do PostgreSQL.
DB_PASSWORD=
CRITPLAY_ADMIN_USERNAME=
CRITPLAY_ADMIN_PASSWORD=
CRITPLAY_ADMIN_NAME=Administrador
GGDEALS_API_KEY=
RAWG_API_KEY=
RECOVERY_ENABLED=false
RATE_LIMIT_ENABLED=true
# Recuperação opcional; só habilite depois de testar um SMTP acessível na VM.
MAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
