# Configure no painel do provedor; nunca use as credenciais de exemplo em produção.
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=0.0.0.0
PORT=8080
DB_URL=jdbc:postgresql://seu-endpoint.neon.tech:5432/critplay?sslmode=verify-full
DB_USERNAME=
DB_PASSWORD=
SESSION_COOKIE_SECURE=true
APP_BASE_URL=https://seu-dominio.example
# Imagens persistem no PostgreSQL; o diretório é apenas temporário.
DB_POOL_SIZE=4
CRITPLAY_ADMIN_USERNAME=
CRITPLAY_ADMIN_PASSWORD=
CRITPLAY_ADMIN_NAME=
GGDEALS_API_KEY=
RAWG_API_KEY=
RECOVERY_ENABLED=false
RATE_LIMIT_ENABLED=true
DEMO_DATA_ENABLED=false
# Opcionais para recuperação de senha por SMTP:
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Avisos de cadastro/e-mail/senha e transporte compartilhado com recuperação.
EMAIL_PROVIDER=smtp
EMAIL_NOTIFICATIONS_ENABLED=false
# Alternativa API HTTPS: EMAIL_PROVIDER=resend (exige domínio verificado).
RESEND_API_KEY=
