# Copie para .env na raiz do projeto e preencha localmente.
# Formato de arquivo properties: sem aspas ao redor dos valores.
# .env fica fora do Git e dos arquivos de entrega.
GGDEALS_API_KEY=
GAMESHELF_ADMIN_USERNAME=
GAMESHELF_ADMIN_PASSWORD=
GAMESHELF_ADMIN_NAME=Vinicius
# Ao publicar com HTTPS, habilite o cookie seguro:
SESSION_COOKIE_SECURE=false

# Recuperação de senha por e-mail (opcional; desativada por padrão).
RECOVERY_ENABLED=false
APP_BASE_URL=http://localhost:8080
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_AUTH=true
MAIL_STARTTLS=true
# PostgreSQL opcional. Só use após definir uma senha e ativar o profile postgres.
DB_URL=jdbc:postgresql://localhost:5432/gameshelf
DB_USERNAME=gameshelf
DB_PASSWORD=
# Limites por IP de login/cadastro/recuperação devem ficar ligados no uso normal.
RATE_LIMIT_ENABLED=true
