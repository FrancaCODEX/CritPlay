# Copie para .env na raiz do projeto e preencha localmente.
# Formato de arquivo properties: sem aspas ao redor dos valores.
# .env fica fora do Git e dos arquivos de entrega.
GGDEALS_API_KEY=
GAMESHELF_ADMIN_USERNAME=
GAMESHELF_ADMIN_PASSWORD=
GAMESHELF_ADMIN_NAME=Vinicius
# Ao publicar com HTTPS, habilite o cookie seguro:
SESSION_COOKIE_SECURE=false
