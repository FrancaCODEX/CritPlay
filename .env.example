# Copie para .env na raiz do projeto e preencha localmente.
# Formato de arquivo properties: sem aspas ao redor dos valores.
# .env fica fora do Git e dos arquivos de entrega.
GGDEALS_API_KEY=
CRITPLAY_ADMIN_USERNAME=
CRITPLAY_ADMIN_PASSWORD=
CRITPLAY_ADMIN_NAME=Vinicius
# Ao publicar com HTTPS, habilite o cookie seguro:
SESSION_COOKIE_SECURE=false

# Recuperação de senha por e-mail (opcional; desativada por padrão).
RECOVERY_ENABLED=false
APP_BASE_URL=http://localhost:8080
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_AUTH=true
MAIL_STARTTLS=true
# H2 local: vazio usa ./data/critplay. Se já possui banco com outro nome,
# renomeie o arquivo com Java parado ou informe sua URL atual, sem .mv.db.
# CRITPLAY_LOCAL_DB_URL=jdbc:h2:file:./data/critplay

# PostgreSQL opcional. Só use após definir uma senha e ativar o profile postgres.
DB_URL=jdbc:postgresql://localhost:5432/critplay
DB_USERNAME=critplay
DB_PASSWORD=
# Docker Compose: para banco existente, use o nome e o volume que já armazenam seus dados.
# Não substitua os valores locais pelos exemplos ao atualizar. Veja docs/ATUALIZACAO_NOMES.md.
DB_NAME=critplay
POSTGRES_VOLUME_NAME=critplay-postgres
# Limites por IP de login/cadastro/recuperação devem ficar ligados no uso normal.
RATE_LIMIT_ENABLED=true

# Opcional: metadados do catálogo (RAWG, plano pessoal gratuito)
RAWG_API_KEY=

# Dados fictícios para testes/apresentação no banco atual (opcional).
# Ative uma vez, inicialize, depois volte a false. Veja docs/DADOS_DEMONSTRACAO.md.
DEMO_DATA_ENABLED=false
# Vazio: usa os jogos originais do catálogo. Opcional: títulos exatos separados por vírgula.
DEMO_GAME_TITLES=
